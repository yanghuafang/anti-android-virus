# ============================================================================
# Build systems
# ============================================================================
# Nothing generated should land in the checkout at all: CMake, Gradle and the
# NDK are all pointed at ../anti-android-virus-build (CMakePresets.json,
# scripts/common.sh, android/build.gradle). These stay as a safety net for a
# tool invoked by hand with its own defaults -- a bare "build/" matches that
# directory at any depth, including android/app/.
build/
.gradle/
.cxx/
.externalNativeBuild/
captures/

# CMake leftovers from an accidental in-source configure.
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt

# Generator output from an in-source configure (root only, so a hand-written or
# vendored Makefile deeper in the tree is still tracked).
/Makefile
/build.ninja
/.ninja_deps
/.ninja_log

# ============================================================================
# Compiled artifacts
# ============================================================================
# Object files and compiler by-products
*.o
*.obj
*.slo
*.lo
*.d
*.gch
*.pch

# Static libraries
*.a
*.la
*.lai
*.lib

# Shared libraries (Linux / macOS / Windows)
*.so
*.so.*
*.dylib
*.dll

# Executables and debug info
*.exe
*.out
*.app
*.pdb
*.dSYM/

# ============================================================================
# Test / analysis output
# ============================================================================
# Coverage: gcovr reports into the build tree, but a stray in-tree gcov run
# leaves these behind (GCC), as does an instrumented binary (LLVM).
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
coverage_html/

# libFuzzer crash / timeout reproducers, written to the working directory.
crash-*
leak-*
timeout-*
oom-*

# ============================================================================
# Tooling caches
# ============================================================================
# clangd / language servers. compile_commands.json is generated by CMake.
.cache/
compile_commands.json

# ============================================================================
# IDEs and editors
# ============================================================================
# VS Code: ignore the directory but keep shared, checked-in configuration.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# JetBrains / Android Studio (.idea/ covers misc.xml, *.iml, ...)
.idea/
*.iml

# Visual Studio
.vs/
*.user
*.suo

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate

# Vim / Emacs / misc editor backups
*~
*.swp
*.swo
*.swn
\#*\#
.\#*

# ============================================================================
# OS metadata
# ============================================================================
# macOS (Finder metadata; AppleDouble sidecars on non-APFS volumes)
.DS_Store
._*

# Linux (KDE per-folder view; NFS silly-rename temp files)
.directory
.nfs*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# Project-specific
# ============================================================================
# Generated sample fixtures (sigtool gen-sample; scripts/run.sh writes samples/)
sample.dex
sample.sig

# Android: machine-local SDK path, build output, and signing material.
local.properties
*.apk
*.aab
*.hprof
*.log
output.json
*.jks
*.keystore
google-services.json
